# Copy to .env and fill in values
# Production on Vercel: use a Neon connection string (not your NAS IP)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"
APP_URL="https://warehousewms.vercel.app"

ADMIN_EMAIL="dispatch@techchefstx.com"
ADMIN_PASSWORD="CHANGE_ME"
ADMIN_NAME="Dispatch"

# Set true only for first demo seed
SEED_DEMO="false"

# Jobber OAuth (Settings → Integrations → Jobber)
JOBBER_CLIENT_ID=""
JOBBER_CLIENT_SECRET=""
# Optional override; defaults to APP_URL + /api/integrations/jobber/callback
JOBBER_REDIRECT_URI=""
JOBBER_API_VERSION="2025-04-16"
